{
  "description": "freshdeps: flag outdated versions right after Claude writes a manifest, workflow or Dockerfile",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check_written_file.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
