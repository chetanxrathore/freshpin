#!/bin/sh
# Run the bundled freshpin with the first Python >= 3.9 that actually starts here.
# Some sandboxes (e.g. Claude Code's) block non-system interpreters, so a broken
# `python3` on PATH is skipped in favour of the next one, such as /usr/bin/python3.
# No external commands (dirname...) here: a hook may run with a minimal PATH.
case $0 in */*) dir=${0%/*} ;; *) dir=. ;; esac
dir=$(CDPATH='' cd -- "$dir" && pwd)
for py in python3 /usr/bin/python3 python3.15 python3.14 python3.13 python3.12 python3.11 python3.10 python3.9 python; do
  if command -v "$py" >/dev/null 2>&1 &&
    "$py" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    exec "$py" "$dir/freshpin.py" "$@"
  fi
done
echo "freshpin: no working Python 3.9+ interpreter found" >&2
exit 127
